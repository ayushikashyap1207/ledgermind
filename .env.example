ENVIRONMENT=local
LOG_LEVEL=INFO
# Set a bearer token to protect /query, /ingest, /ingest/sql, and /eval/run.
# Leave empty for local development only.
API_KEY=
AUDIT_LOG_ENABLED=true

# --- LLM provider: anthropic | openai | groq | ollama ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
# Local/self-hosted option: LLM_PROVIDER=ollama, LLM_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.5

# --- Structured data ---
# Local dev (sqlite):
DATABASE_URL=sqlite:///./ledgermind.db
# Docker-compose (postgres) overrides this — see docker-compose.yml
# DATABASE_URL=postgresql+psycopg2://ledgermind:ledgermind@postgres:5432/ledgermind
# DATABASE_READONLY_URL=postgresql+psycopg2://ledgermind_ro:ledgermind_ro@postgres:5432/ledgermind
SQL_ROW_LIMIT=500
SQL_QUERY_TIMEOUT_SECONDS=10

# --- RAG ---
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=ledgermind_docs
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_USE_HTTP=false
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVAL_K=8
RETRIEVAL_K_AFTER_MMR=4

# --- Eval / tracing ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ledgermind
